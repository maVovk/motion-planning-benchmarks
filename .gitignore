# Local dependencies and Python caches
.venv/
__pycache__/
*.py[cod]

# CMake build trees and generated compilation databases
/build/
/build-*/
/cmake-build-*/
/compile_commands.json

# clangd index caches (keep a possible .clangd configuration file trackable)
.clangd/
.cache/clangd/

# Local environment and OS metadata
.env
.env.*
!.env.example
.DS_Store
.vscode

# Large, reproducible perf recordings (SVGs and folded stacks remain trackable)
/results/planning/profiles/*.data
/results/planning/profiles/*.data.old
